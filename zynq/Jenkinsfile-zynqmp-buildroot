pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(
                logRotator(
                    artifactNumToKeepStr: '50',
                    numToKeepStr: '100'
                )
            )
        quietPeriod 600
    }

    parameters {
        choice choices: ['nxp', 'upstream'], description: 'Git remote', name: 'remote'
    }

    triggers{ pollSCM('30 */12 * * *') }

    stages {
        stage('sources') {
            steps {
                script {
                    def branch = "refs/remotes/nxp/cosim"
                    if (params.remote == "nxp") {
                        branch = "refs/remotes/nxp/cosim"
                    } else if (params.remote == "upstream") {
                        branch = "refs/remotes/upstream/master"
                    }

                    echo "Building branch " + branch

                    dir("work/buildroot") {
                        checkout(
                            changelog: true,
                            poll: true,
                            scm: [
                                $class: 'GitSCM',
                                branches: [[name: branch]],
                                doGenerateSubmoduleConfigurations: false,
                                extensions: [
                                    [ $class: 'CleanCheckout'],
                                    [ $class: 'CheckoutOption',
                                        timeout: 30
                                    ],
                                    [ $class: 'CloneOption',
                                        honorRefspec: true,
                                    ]
                                ],
                                submoduleCfg: [],
                                userRemoteConfigs: [
                                    [
                                        name: "nxp",
                                        url: 'ssh://git@bitbucket.sw.nxp.com/imxswarch/buildroot.git'
                                    ],
                                    [
                                        name: "upstream",
                                        url: 'https://git.buildroot.net/buildroot.git'
                                    ],
                                ]
                            ]
                        )
                    }
                }
            }
        }

        stage('build') {
            steps {
                script {
                    if (params.remote == "upstream") {
                        env.DEFCONFIG = "zynqmp_qemu_zcu102_defconfig"
                    } else if (params.remote == "nxp") {
                        env.DEFCONFIG = "zynqmp_cosim_defconfig"
                    } else {
                        env.DEFCONFIG = "defconfig"
                    }
                    dir("work/buildroot") {
                        sh '''
                            env > myenv-jenkins.txt
                            defconfig_file=${WORKSPACE}/zynq/buildroot-${DEFCONFIG}
                            if [ -e ${defconfig_file} ]; then
                              cp ${WORKSPACE}/zynq/buildroot-${DEFCONFIG} configs/${DEFCONFIG}
                            fi
                            cp ${WORKSPACE}/zynq/linux-xilinx_zynqmp_defconfig board/zynqmp/xilinx_zynqmp_defconfig
                            make "${DEFCONFIG}"
                            make
                            make sdk
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            dir('work/buildroot/output/images') {
                archiveArtifacts artifacts: '*', fingerprint: true
            }
        }
    }
}
